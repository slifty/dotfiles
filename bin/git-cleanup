#!/usr/bin/env bash
#
# Delete local branches that have already been merged into the base branch.
#
# Usage: git cleanup [base]
#
# The base branch defaults to the first of these that exists locally:
# dev, development, main, master.

set -e

PROTECTED_BRANCHES=(dev development main master)

base="$1"

if [ -z "$base" ]; then
	for candidate in "${PROTECTED_BRANCHES[@]}"; do
		if git show-ref --verify --quiet "refs/heads/$candidate"; then
			base="$candidate"
			break
		fi
	done
fi

# Never delete a protected branch, or the current one (marked "* name").
# Note this is a substring match, so a branch named "devops" is also
# skipped -- it errs towards keeping branches rather than deleting them.
pattern="$(
	IFS='|'
	printf '%s' "${PROTECTED_BRANCHES[*]}"
)|\*"

# With no base branch found, --merged falls back to HEAD.
git branch --merged ${base:+"$base"} \
	| grep -Ev "$pattern" \
	| xargs -n 1 git branch -d
