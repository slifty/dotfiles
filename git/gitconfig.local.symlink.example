[user]
        name = AUTHOR_NAME
        email = AUTHOR_EMAIL
        # GPG signing key ID for commit signing
        # Find it with: gpg --list-secret-keys --keyid-format LONG
        # Use the long key ID after "sec   rsa4096/"
        signingkey = GPG_SIGNING_KEY
[credential]
        helper = GIT_CREDENTIAL_HELPER
